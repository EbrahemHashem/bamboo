# ============================================================
# BAMBOO DISPOSABLES BV — Environment Variables
# ============================================================
# Vul deze waarden in nadat de installatie voltooid is.
# NOOIT dit bestand committen naar git (.gitignore doet dit automatisch).
# ============================================================

# ---------- Claude / Anthropic ----------
ANTHROPIC_API_KEY=

# ---------- Airtable (Systeem 1 + 3 shared base) ----------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ---------- Apify (Systeem 1 — Meta Ad Library scraping) ----------
APIFY_API_TOKEN=

# ---------- Meta Ads (Systeem 3) ----------
# Zie systems/3-ad-management/meta-ads-setup.md voor hoe je deze genereert
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# ---------- Nano Banana 2 (Systeem 2 — 4K image generation) ----------
NANO_BANANA_API_KEY=
# Of via Google/Gemini direct:
GEMINI_API_KEY=

# ---------- Google Drive (Systeem 2 — asset opslag) ----------
GOOGLE_DRIVE_CREDENTIALS_JSON=

# ---------- Telegram (notificaties alle systemen) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Email (weekly digest Systeem 1) ----------
SENDER_EMAIL=
NATHAN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ---------- n8n (lokaal of cloud) ----------
# Als lokaal via Docker:
N8N_HOST=
# Als cloud (n8n.cloud):
# N8N_HOST=https://yourname.app.n8n.cloud
N8N_API_KEY=

# ---------- Shopify (Systeem 4 Conversion + Systeem 5 Revenue) ----------
# Custom App → Admin API access token
# Zie systems/4-conversion-engine/shopify-setup.md
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_URL=

# ---------- Klaviyo (Systeem 5 — email/SMS marketing) ----------
# Private API Key met scopes: Campaigns, Flows, Lists, Profiles, Metrics, Segments
# Zie systems/5-revenue-engine/klaviyo-setup.md
KLAVIYO_API_KEY=

# ---------- Bamboo specifieke instellingen ----------
BAMBOO_CLIENT_DIR=
BAMBOO_DEFAULT_LANG=
BAMBOO_DAILY_BUDGET_CAP=
BAMBOO_ROAS_PAUSE_THRESHOLD=
BAMBOO_ROAS_SCALE_THRESHOLD=

# ---------- Conversion Engine thresholds (Systeem 4) ----------
BAMBOO_CR_FLAG_THRESHOLD=
BAMBOO_CLICKS_NO_CONVERSION_THRESHOLD=
BAMBOO_AB_MIN_SESSIONS=
BAMBOO_AB_MIN_LIFT=

# ---------- Reorder timing (Systeem 5) ----------
# Geschatte gebruiksduur per volume (dagen tot depletion)
BAMBOO_REORDER_24_DAYS=
BAMBOO_REORDER_48_DAYS=
BAMBOO_REORDER_96_DAYS=
BAMBOO_REORDER_REMINDER_WINDOW=

# ---------- Intelligence Engine thresholds (Systeem 6) ----------
BAMBOO_CPA_SPIKE_MULTIPLIER=
